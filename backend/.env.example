# Live providers. Without HERE_API_KEY the app runs in clearly-labelled demo mode.
HERE_API_KEY=
PLANNER_PROVIDER=here            # here | demo
OPEN_METEO_API_KEY=              # optional (commercial plan); free tier needs no key

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional shared cache (recommended in production): weather + plans + heatmaps.
REDIS_URL=

# Tuning
TRACTOR_TRAILER_TARE_LB=35000
HEATMAP_MAX_CELLS=900
WEATHER_TTL_S=1800
